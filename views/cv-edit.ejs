<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit CV - C.O.A. CV BUILDER</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/cv-builder.css">
</head>
<body>
    <!-- HEADER -->
    <header>
        <nav class="navbar">
            <div class="nav-container">
                <div class="logo-section">
                    <img src="/images/logo.png" alt="C.O.A. TECH Logo" class="logo">
                    <h1>C.O.A. CV BUILDER</h1>
                </div>
                <div class="nav-links">
                    <a href="/dashboard">Dashboard</a>
                    <a href="/auth/logout" class="btn-primary">Logout</a>
                </div>
            </div>
        </nav>
    </header>

    <section class="cv-builder-container">
        <div class="cv-builder-box">
            <h2>Edit CV</h2>
            <p class="cv-subtitle">Update your CV details below. Changes will be saved when you click “Save Changes”.</p>

            <% if (error) { %>
                <div class="message error"><%= error %></div>
            <% } %>

            <form action="/cv/<%= cv._id %>/edit" method="POST" class="cv-form">

                <h3>Personal Information</h3>
                <div class="cv-grid">
                    <div class="form-group">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="fullName" value="<%= cv.fullName || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="jobTitle">Professional Title</label>
                        <input type="text" id="jobTitle" name="jobTitle" value="<%= cv.jobTitle || '' %>" required>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" value="<%= cv.email || user.email %>" required>
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone</label>
                        <input type="tel" id="phone" name="phone" value="<%= cv.phone || user.phone %>" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="location">Location</label>
                        <input type="text" id="location" name="location" value="<%= cv.location || '' %>">
                    </div>
                </div>

                <h3>Professional Summary</h3>
                <div class="form-group">
                    <textarea id="summary" name="summary" rows="4"><%= cv.summary || '' %></textarea>
                </div>

                <h3>Education</h3>

                <div id="education-section">
                    <% 
                        const eduList = (cv.education && Array.isArray(cv.education) && cv.education.length > 0)
                            ? cv.education
                            : [{ school:'', degree:'', location:'', startYear:'', endYear:'', details:'' }];
                    %>

                    <% eduList.forEach(function(edu, index) { %>
                        <div class="cv-grid education-block">
                            <div class="form-group">
                                <label>School / Institution</label>
                                <input type="text" name="education[<%= index %>][school]" value="<%= edu.school || '' %>">
                            </div>

                            <div class="form-group">
                                <label>Degree / Qualification</label>
                                <input type="text" name="education[<%= index %>][degree]" value="<%= edu.degree || '' %>">
                            </div>

                            <div class="form-group">
                                <label>Location</label>
                                <input type="text" name="education[<%= index %>][location]" value="<%= edu.location || '' %>">
                            </div>

                            <div class="form-group">
                                <label>Start Year</label>
                                <input type="text" name="education[<%= index %>][startYear]" value="<%= edu.startYear || '' %>">
                            </div>

                            <div class="form-group">
                                <label>End Year</label>
                                <input type="text" name="education[<%= index %>][endYear]" value="<%= edu.endYear || '' %>">
                            </div>

                            <div class="form-group full-width">
                                <label>Details / Achievements</label>
                                <textarea name="education[<%= index %>][details]" rows="3"><%= edu.details || '' %></textarea>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <button type="button" id="add-education" class="btn-secondary">
                    + Add Another Education
                </button>

                <h3>Work Experience</h3>
                <div class="cv-grid">
                    <div class="form-group">
                        <label for="expCompany">Company</label>
                        <input type="text" id="expCompany" name="expCompany" value="<%= cv.experience?.company || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="expRole">Job Title</label>
                        <input type="text" id="expRole" name="expRole" value="<%= cv.experience?.role || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="expLocation">Location</label>
                        <input type="text" id="expLocation" name="expLocation" value="<%= cv.experience?.location || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="expStartYear">Start Year</label>
                        <input type="text" id="expStartYear" name="expStartYear" value="<%= cv.experience?.startYear || '' %>">
                    </div>

                    <div class="form-group">
                        <label for="expEndYear">End Year</label>
                        <input type="text" id="expEndYear" name="expEndYear" value="<%= cv.experience?.endYear || '' %>">
                    </div>

                    <div class="form-group full-width">
                        <label for="expDetails">Responsibilities / Achievements</label>
                        <textarea id="expDetails" name="expDetails" rows="4"><%= cv.experience?.details || '' %></textarea>
                    </div>
                </div>

                <h3>Skills</h3>
                <div class="form-group">
                    <textarea id="skills" name="skills" rows="4"><%= cv.skills || '' %></textarea>
                </div>

                <h3>Languages (Optional)</h3>
                <div class="form-group">
                    <textarea id="languages" name="languages" rows="3"><%= cv.languages || '' %></textarea>
                </div>

                <h3>Certifications / Training (Optional)</h3>
                <div class="form-group">
                    <textarea id="certifications" name="certifications" rows="3"><%= cv.certifications || '' %></textarea>
                </div>

                <div class="cv-actions">
                    <a href="/cv/my-cvs" class="btn-secondary">Cancel</a>
                    <button type="submit" class="btn-submit">Save Changes</button>
                </div>
            </form>
        </div>
    </section>

    <script>
        let educationIndex = <%= (cv.education && Array.isArray(cv.education) && cv.education.length > 0) ? cv.education.length : 1 %>;

        document.getElementById('add-education').addEventListener('click', function () {
            const container = document.getElementById('education-section');
            const blocks = document.querySelectorAll('.education-block');
            const lastBlock = blocks[blocks.length - 1];
            const newBlock = lastBlock.cloneNode(true);

            newBlock.querySelectorAll('input, textarea').forEach(function (input) {
                input.name = input.name.replace(/\[\d+\]/, '[' + educationIndex + ']');
                input.value = '';
            });

            container.appendChild(newBlock);
            educationIndex++;
        });
    </script>

</body>
</html>