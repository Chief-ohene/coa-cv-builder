<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Executive Template</title>
</head>
<body>

<h1><%= cv.fullName %></h1>
<p><%= cv.email %> | <%= cv.phone %> | <%= cv.location %></p>

<% if (cv.summary) { %>
<h2>Summary</h2>
<p><%= cv.summary %></p>
<% } %>

<% if (cv.experience && cv.experience.company) { %>
<h2>Experience</h2>
<p><strong><%= cv.experience.role %></strong> – <%= cv.experience.company %></p>
<p><%= cv.experience.details %></p>
<% } %>

<% if (cv.education && cv.education.length > 0) { %>
<div class="compact-section">
<h3>Education</h3>

<% cv.education.forEach(function(edu) { %>
<p>
<strong><%= edu.degree || '' %></strong> – <%= edu.school || '' %>
<span class="compact-dates">
<%= edu.startYear || '' %> - <%= edu.endYear || '' %>
</span>
</p>
<div class="clear"></div>
<p><%= edu.details || '' %></p>
<br>
<% }) %>

</div>
<% } %>

<% if (cv.skills) { %>
<h2>Skills</h2>
<p><%= cv.skills %></p>
<% } %>

<button onclick="window.print()">Download PDF</button>

<% if (cv.languages) { %>
<div class="exec-section">
<h3>Languages</h3>
<p><%= cv.languages %></p>
</div>
<% } %>

<% if (cv.certifications) { %>
<div class="exec-section">
<h3>Certifications</h3>
<p><%= cv.certifications %></p>
</div>
<% } %>

</body>
</html>